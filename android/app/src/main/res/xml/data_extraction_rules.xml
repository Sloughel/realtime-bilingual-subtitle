<?xml version="1.0" encoding="utf-8"?>
<!-- 不参与云备份与设备迁移：仅本地保存服务器地址与悬浮窗偏好 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

# 服务端配置示例
# 复制为 .env 后填入真实值，.env 已被 .gitignore 排除，不会进入仓库

# ---------- 服务监听 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---------- 语音识别（faster-whisper）----------
# 模型规格：small / medium / large-v3，首次使用会自动从镜像下载
# 也可填本地目录路径（相对项目根目录或绝对路径），如 models/faster-whisper-medium
WHISPER_MODEL=medium
# cuda / cpu
WHISPER_DEVICE=cuda
# cuda 环境用 float16；cpu 环境建议 int8
WHISPER_COMPUTE_TYPE=float16
# GPU 不可用时自动降级为 CPU 所用的精度（FM-04）
WHISPER_CPU_COMPUTE_TYPE=int8

# ---------- 断句（VAD）----------
VAD_MIN_SILENCE_MS=500
VAD_MIN_SPEECH_MS=300
VAD_MAX_SENTENCE_MS=8000
# 语音判定阈值；留空则按 threshold-0.15 推导静音阈值
VAD_THRESHOLD=0.5
VAD_NEG_THRESHOLD=
# 句首回溯，避免吞掉首音
VAD_PRE_ROLL_MS=200

# ---------- 翻译（OpenAI 兼容接口，默认 DeepSeek）----------
TRANSLATE_BASE_URL=https://api.deepseek.com
TRANSLATE_API_KEY=sk-在此填入你的密钥
TRANSLATE_MODEL=deepseek-chat
TRANSLATE_TIMEOUT_S=10
TRANSLATE_MAX_RETRY=2
TRANSLATE_CONCURRENCY=3

# ---------- 会话 ----------
SESSION_TTL_S=30
MAX_QUEUE=10

# ---------- 字幕历史（可选，本地 JSONL）----------
# 开启后每句字幕（含原文/译文）追加到 SUBTITLE_HISTORY_PATH；文件已被 .gitignore 排除。
# 默认关闭：字幕内容属于用户数据，是否需要落盘由部署者决定。
SUBTITLE_HISTORY=false
SUBTITLE_HISTORY_PATH=logs/subtitles.jsonl

# ---------- 成本监控与通知（FR-21 / NFR-10）----------
# 用量不设上限；累计达「金额」或「token 数」（先到者）即通知一次并重置计数
COST_NOTIFY_YUAN=10
COST_NOTIFY_TOKENS=1000000000
# 所用模型的参考单价（元 / 百万 token），请按实际计费修改
PRICE_IN_PER_M=2.0
PRICE_OUT_PER_M=8.0

# ---------- 日志 ----------
LOG_LEVEL=INFO
